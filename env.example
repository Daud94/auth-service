# Copy to .env (never commit real values) and fill in per environment.
# The service fails fast at startup when any required value is missing or blank.

PORT=3000

# Signs/verifies mobile user JWTs. Use a long random value, unique per environment.
JWT_SECRET=

# Required by the internal service-to-service guard (header: x-internal-api-key).
INTERNAL_API_KEY=

# Shared secret used to verify the SMS provider webhook signature (header: x-sms-signature).
SMS_WEBHOOK_SECRET=

# Comma-separated allow-list of browser origins, e.g. https://app.wayagram.ng,https://admin.wayagram.ng
CORS_ORIGINS=

# bcrypt cost factor (integer, default 12).
BCRYPT_ROUNDS=12
